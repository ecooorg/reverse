{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --test-concurrency=1 dist-tests/benchmark-stats.test.js dist-tests/process-parse.test.js dist-tests/legacy-linux-property.test.js dist-tests/legacy-linux-n-step3.test.js dist-tests/legacy-linux-n-closeup.test.js"
  },
  "mutate": [
    "dist/benchmark-stats.js",
    "dist/process-parse.js",
    "dist/legacy-linux-symver.js",
    "dist/legacy-linux-packages.js"
  ],
  "coverageAnalysis": "off",
  "concurrency": 3,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "ignorePatterns": [
    ".git",
    "reports",
    ".stryker-tmp",
    "ci-logs",
    "coverage",
    ".reverse"
  ],
  "thresholds": {
    "high": 70,
    "low": 50,
    "break": 45
  },
  "tsconfigFile": "stryker-no-tsconfig.json"
}
